# AI provider keys are used only by the server-side /api/estimate endpoint.
# Never rename this to PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Optional Supabase cloud persistence.
# Leave both empty to use local browser storage.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional USDA FoodData Central API key. Without one, the limited public DEMO_KEY is used.
USDA_FDC_API_KEY=

# Optional Gemini Google Search grounding. Disabled by default to prevent unexpected search charges.
# Set true only after reviewing Google's current grounding pricing and limits.
GEMINI_WEB_SEARCH_ENABLED=false
GEMINI_WEB_SEARCH_MODEL=gemini-3.6-flash

