# AI provider keys are used only by the server-side /api/estimate endpoint.
# Never rename this to PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional Supabase cloud persistence.
# Leave both empty to use local browser storage.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
