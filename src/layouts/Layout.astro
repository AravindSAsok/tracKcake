---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "trackcake — Your food, in focus",
  description = "A simple food diary with thoughtful calorie estimates and a clear view of your last 24 hours."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f7f2" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
