---
import Layout from "../layouts/Layout.astro";
---

<Layout title="trackcake — Your food, in focus">
  <div class="app-shell" id="top">
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="#top" aria-label="trackcake home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 36 36" fill="none">
              <path d="M18 3.5c7.4 0 13.4 6 13.4 13.4S25.4 30.3 18 30.3 4.6 24.3 4.6 16.9 10.6 3.5 18 3.5Z" fill="currentColor" opacity=".16"/>
              <path d="M18 5.8c6.2 0 11.2 5 11.2 11.2S24.2 28.2 18 28.2 6.8 23.2 6.8 17 11.8 5.8 18 5.8Z" stroke="currentColor" stroke-width="1.8"/>
              <path d="M18 6v22M7.2 17h21.6M10.4 9.4l15.2 15.2M25.6 9.4 10.4 24.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M17.8 5.7c-.4-2 1-3.8 3.6-4.2" stroke="#91B96A" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-name">track<span>cake</span></span>
        </a>

        <nav class="top-nav" aria-label="Main navigation">
          <a class="nav-link active" href="#overview">Overview</a>
          <a class="nav-link" href="#diary">Food diary</a>
        </nav>

        <div class="top-actions">
          <button class="secondary-button account-trigger" id="account-trigger" type="button" aria-haspopup="dialog" aria-controls="account-dialog">
            <span class="account-trigger-copy">
              <strong id="account-display-name">Guest account</strong>
              <small id="account-display-email"></small>
            </span>
          </button>
          <div class="storage-status" id="storage-status" title="Where your diary is saved">
            <span class="status-dot"></span>
            <span id="storage-label">On this device</span>
          </div>
          <button class="icon-button goal-shortcut" id="goal-shortcut" type="button" aria-label="Edit daily calorie goal" title="Edit daily goal">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M3 12h18" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="page-content">
      <section class="welcome-row" id="overview">
        <div>
          <p class="eyebrow"><span class="eyebrow-mark"></span> YOUR PERSONAL FOOD DIARY</p>
          <h1>Eat well. <em>Feel good.</em></h1>
          <p class="welcome-copy">A little more awareness, one meal at a time.</p>
        </div>
        <div class="date-card">
          <span class="date-icon" aria-hidden="true">◷</span>
          <div>
            <strong id="current-date">Today</strong>
            <span>Calendar day · 12 AM to 12 AM</span>
          </div>
        </div>
      </section>

      <section class="overview-grid" aria-label="Nutrition overview">
        <article class="calorie-card">
          <div class="card-heading inverse-heading">
            <div>
              <p class="card-kicker">YOUR CALORIE BALANCE</p>
              <h2>Every bite counts.</h2>
            </div>
            <span class="live-pill"><span></span> LIVE</span>
          </div>

          <div class="calorie-content">
            <div class="progress-ring" id="calorie-ring" style="--progress: 0deg" role="img" aria-label="Calorie goal progress">
              <div class="ring-center">
                <span class="ring-label">EATEN</span>
                <strong id="calories-total">0</strong>
                <span class="ring-unit">kcal</span>
              </div>
            </div>

            <div class="calorie-copy">
              <p class="muted-inverse">REMAINING TO YOUR GOAL</p>
              <div class="remaining-line">
                <strong id="remaining-value">2,000</strong>
                <span id="remaining-unit">kcal left</span>
              </div>
              <p class="progress-caption" id="progress-caption">Set a goal and start logging your meals.</p>
              <p class="daily-guidance" id="daily-guidance" aria-live="polite">Log your first meal to see your daily progress.</p>
              <div class="progress-track"><span id="progress-fill"></span></div>
              <div class="progress-ends">
                <span>0 kcal</span>
                <span id="goal-label">2,000 kcal goal</span>
              </div>
            </div>
          </div>

          <div class="calorie-footer">
            <span><span class="footer-spark">✳</span> Based on today · 12 AM–12 AM</span>
            <button class="text-button inverse-button" id="edit-goal" type="button">Edit daily goal <span aria-hidden="true">↗</span></button>
          </div>
        </article>

        <article class="macro-card">
          <div class="card-heading">
            <div>
              <p class="card-kicker">NUTRIENT SNAPSHOT</p>
              <h2>What's on your plate</h2>
            </div>
            <span class="macro-icon" aria-hidden="true">◌</span>
          </div>
          <p class="card-description">A quick look at your macros for today.</p>

          <div class="macro-list">
            <div class="macro-row">
              <div class="macro-meta"><span class="macro-dot protein-dot"></span><span>Protein</span><strong id="protein-total">0 g</strong></div>
              <div class="macro-track"><span id="protein-bar" class="protein-bar"></span></div>
            </div>
            <div class="macro-row">
              <div class="macro-meta"><span class="macro-dot carbs-dot"></span><span>Carbs</span><strong id="carbs-total">0 g</strong></div>
              <div class="macro-track"><span id="carbs-bar" class="carbs-bar"></span></div>
            </div>
            <div class="macro-row">
              <div class="macro-meta"><span class="macro-dot fat-dot"></span><span>Fat</span><strong id="fat-total">0 g</strong></div>
              <div class="macro-track"><span id="fat-bar" class="fat-bar"></span></div>
            </div>
          </div>

          <div class="macro-footnote"><span aria-hidden="true">ⓘ</span> Macro values are estimates and may be incomplete.</div>
        </article>
      </section>

      <section class="daily-insights" aria-label="Today's meals and weekly consistency">
        <div class="meal-breakdown">
          <div class="insights-heading"><p class="card-kicker">TODAY&#39;S MEALS</p><span class="insights-subtitle">Calories by meal</span></div>
          <div class="meal-totals">
            <div class="meal-total"><span>Breakfast</span><strong id="meal-breakfast">0 kcal</strong></div>
            <div class="meal-total"><span>Lunch</span><strong id="meal-lunch">0 kcal</strong></div>
            <div class="meal-total"><span>Dinner</span><strong id="meal-dinner">0 kcal</strong></div>
            <div class="meal-total"><span>Snacks</span><strong id="meal-snack">0 kcal</strong></div>
          </div>
        </div>
        <div class="weekly-consistency">
          <div class="insights-heading"><p class="card-kicker">LAST 7 DAYS</p><strong class="week-summary" id="week-summary">0 of 7 near goal</strong></div>
          <div class="week-days" id="week-days" aria-label="Daily calorie progress for the last seven days"></div>
          <p class="week-caption">Days within 10% of your daily target</p>
        </div>
      </section>

      <section class="day-timeline-card" aria-labelledby="day-timeline-title">
        <div class="day-timeline-heading">
          <div>
            <p class="card-kicker">TODAY'S FOOD</p>
            <h2 id="day-timeline-title">What you ate today</h2>
            <p>Midnight to midnight · 12:00 AM – 11:59 PM</p>
          </div>
          <span class="day-timeline-total" id="day-timeline-total">0 kcal · 0 foods</span>
        </div>
        <div class="day-timeline-list" id="day-timeline-list" aria-live="polite">
          <p class="day-timeline-empty">Your meals will appear here as you log them.</p>
        </div>
      </section>

      <section class="content-grid">
        <div class="main-column">
          <section class="quick-add-card" aria-labelledby="quick-add-title">
            <div class="section-heading quick-heading">
              <div>
                <p class="card-kicker">QUICK FOOD LOG</p>
                <h2 id="quick-add-title">What did you eat?</h2>
                <p>Describe your food normally, or paste a TrackCake food-log JSON (up to 100,000 characters) to import entries directly without an AI estimate.</p>
              </div>
              <span class="ai-orb" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m12 2 1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7L12 2Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>
              </span>
            </div>

            <form id="quick-add-form" class="quick-form">
              <label class="sr-only" for="food-description">Describe what you ate and how much</label>
              <textarea id="food-description" rows="8" maxlength="100000" placeholder="e.g. 2 idlis and 1 cup sambar… or paste TrackCake food-log JSON" required></textarea>
              <div class="quick-form-bottom">
                <div class="quick-controls">
                  <label class="control-label" for="quick-meal">Meal
                    <select id="quick-meal">
                      <option value="auto">Auto · based on time</option>
                      <option value="breakfast">Breakfast</option>
                      <option value="lunch">Lunch</option>
                      <option value="dinner">Dinner</option>
                      <option value="snack">Snack</option>
                    </select>
                  </label>
                  <label class="control-label" for="quick-date">Food date
                    <input id="quick-date" type="date" aria-label="Choose the day you ate this food" />
                  </label>
                  <label class="control-label" for="quick-time">Eaten at
                    <input id="quick-time" type="datetime-local" />
                  </label>
                  <label class="control-label" for="quick-provider">AI provider
                    <select id="quick-provider">
                      <option value="auto">Automatic fallback</option>
                      <option value="groq">Groq</option>
                      <option value="gemini" selected>Gemini</option>
                      <option value="openrouter">OpenRouter</option>
                    </select>
                  </label>
                  <label class="control-label" for="quick-model">Model
                    <select id="quick-model" disabled>
                      <option value="">Automatic fallback</option>
                    </select>
                  </label>
                  <span class="model-status" id="quick-model-status" aria-live="polite">Automatic fallback is enabled.</span>
                </div>
                <div class="quick-buttons">
                  <input id="food-photo-input" type="file" accept="image/*" hidden />
                  <button class="secondary-button" id="photo-add" type="button">
                    <span aria-hidden="true">▧</span> Photo entry
                  </button>
                  <button class="secondary-button" id="manual-add" type="button">
                    <span aria-hidden="true">＋</span> Manual entry
                  </button>
                  <button class="secondary-button" id="live-search-button" type="button" title="Spend Firecrawl credits only when you choose live research">
                    <span aria-hidden="true">⌕</span> Live web search
                  </button>
                  <button class="secondary-button" id="recipe-builder-open" type="button"><span aria-hidden="true">＋</span> Build recipe</button>
                  <button class="primary-button" id="estimate-button" type="submit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7L12 2Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>
                    <span>Estimate with AI</span>
                  </button>
                </div>
              </div>
              <p class="form-hint" id="estimate-hint"><span aria-hidden="true">✦</span> You'll review every estimate before it is added to your diary.</p>
              <p class="form-hint photo-privacy-hint"><span aria-hidden="true">⌑</span> TrackCake does not store photos. Your selected AI provider may apply its own data-retention policy.</p>
            </form>
          </section>

          <section class="diary-section" id="diary" aria-labelledby="diary-title">
            <div class="diary-heading">
              <div>
                <p class="card-kicker">YOUR FOOD DIARY</p>
                <h2 id="diary-title">Food history <span class="diary-count" id="diary-count">0 entries</span></h2>
              </div>
              <span class="range-total" id="range-total">0 kcal logged</span>
            </div>
            <div class="history-filters">
              <label class="history-filter">Choose a day<input id="history-date" type="date" aria-label="Search food history by date" /></label>
              <label class="history-filter history-search">Search foods<input id="history-search" type="search" placeholder="Search meals or portions…" autocomplete="off" /></label>
              <button class="history-clear" id="history-clear" type="button">All dates</button>
            </div>

            <p class="history-state" id="history-loading" role="status" hidden>Loading your food history…</p>
            <p class="history-state history-error" id="history-error" role="alert" hidden></p>
            <div class="history-list" id="history-list" aria-live="polite"></div>
            <nav class="history-pagination" id="history-pagination" aria-label="Food history pages" hidden>
              <button class="history-page-button" id="history-previous" type="button" disabled>← Previous</button>
              <span id="history-page-label" aria-live="polite">Page 1 of 1</span>
              <button class="history-page-button" id="history-next" type="button" disabled>Next →</button>
            </nav>
            <div class="empty-state" id="history-empty">
              <div class="empty-illustration" aria-hidden="true">
                <span class="empty-plate"></span>
                <span class="empty-leaf">✳</span>
              </div>
              <h3>Your diary starts with a bite.</h3>
              <p>Log your first meal above and it will show up here.</p>
              <button class="text-button" id="empty-add" type="button">Add your first food <span aria-hidden="true">↗</span></button>
            </div>
            <p class="history-note">Your full food diary stays searchable. Pick a date or search by food name and portion.</p>
          </section>
        </div>

        <aside class="side-column">
          <section class="goal-card">
            <div class="side-card-heading">
              <span class="side-card-icon goal-icon" aria-hidden="true">◎</span>
              <span class="side-card-label">DAILY TARGET</span>
              <button class="plain-icon-button" id="goal-edit-small" type="button" aria-label="Edit calorie goal">↗</button>
            </div>
            <div class="goal-number"><strong id="side-goal">2,000</strong><span>kcal</span></div>
            <p>Keep your target realistic and sustainable.</p>
            <div class="goal-divider"></div>
            <div class="goal-mini-row"><span>Logged today</span><strong id="side-consumed">0 kcal</strong></div>
            <div class="goal-mini-row"><span>Daily target</span><strong id="side-target">2,000 kcal</strong></div>
          </section>

          <section class="note-card">
            <div class="note-art" aria-hidden="true">
              <span class="note-sun"></span>
              <span class="note-fruit">●</span>
              <span class="note-leaf">⌁</span>
            </div>
            <p class="note-kicker">A GENTLE REMINDER</p>
            <h3>Progress, not perfection.</h3>
            <p>Estimates are a starting point. Adjust portions and calories to reflect what you actually ate.</p>
          </section>

          <div class="privacy-note">
            <span aria-hidden="true">⌑</span>
            <p>Your food diary stays private. Cloud sync is optional.</p>
          </div>
        </aside>
      </section>

      <dialog class="daily-recap-dialog" id="daily-recap-dialog" aria-labelledby="daily-recap-title">
        <div class="daily-recap-shell">
          <div class="daily-recap-glow" aria-hidden="true"></div>
          <div class="daily-recap-sparkles" aria-hidden="true"><span>✦</span><span>✧</span><span>✦</span><span>·</span><span>✧</span></div>
          <div class="daily-recap-content">
            <p class="daily-recap-kicker" id="daily-recap-kicker">YESTERDAY, IN FOCUS</p>
            <p class="daily-recap-date" id="daily-recap-date"></p>
            <div class="daily-recap-hero-mark" aria-hidden="true">✿</div>
            <h2 id="daily-recap-title">A little progress adds up.</h2>
            <p class="daily-recap-message" id="daily-recap-message"></p>
            <blockquote class="daily-recap-quote" id="daily-recap-quote" hidden></blockquote>
            <div class="daily-recap-calorie">
              <span>CALORIES CONSUMED</span>
              <strong><span id="daily-recap-calories">0</span> <small>kcal</small></strong>
              <small id="daily-recap-goal">of your daily goal</small>
            </div>
            <div class="daily-recap-macros" aria-label="Yesterday's nutrition totals">
              <div><span class="recap-macro-dot protein"></span><small>PROTEIN</small><strong id="daily-recap-protein">0 g</strong></div>
              <div><span class="recap-macro-dot carbs"></span><small>CARBS</small><strong id="daily-recap-carbs">0 g</strong></div>
              <div><span class="recap-macro-dot fat"></span><small>FAT</small><strong id="daily-recap-fat">0 g</strong></div>
            </div>
            <section class="daily-recap-chart-wrap" aria-label="Macro energy breakdown">
              <div class="daily-recap-chart-heading"><strong>Nutrition balance</strong><span id="daily-recap-food-count">0 foods logged</span></div>
              <div class="daily-recap-chart" id="daily-recap-chart" hidden>
                <span id="daily-recap-protein-segment" class="recap-segment protein"></span>
                <span id="daily-recap-carbs-segment" class="recap-segment carbs"></span>
                <span id="daily-recap-fat-segment" class="recap-segment fat"></span>
              </div>
              <p class="daily-recap-chart-empty" id="daily-recap-chart-empty" hidden>Macro details weren't available for yesterday's entries.</p>
              <p class="daily-recap-chart-caption" id="daily-recap-chart-caption"></p>
              <div class="daily-recap-legend"><span><i class="protein"></i> Protein</span><span><i class="carbs"></i> Carbs</span><span><i class="fat"></i> Fat</span></div>
            </section>
            <button class="daily-recap-close" id="daily-recap-close" type="button">Let's make today count <span aria-hidden="true">→</span></button>
            <p class="daily-recap-footnote">A gentle check-in, not a judgement. Nutrition values are estimates.</p>
          </div>
        </div>
      </dialog>

      <footer class="page-footer">
        <span>Made for a little more mindful eating <span aria-hidden="true">♡</span></span>
        <span>trackcake <span class="footer-version">· nutrition estimates are not medical advice</span></span>
      </footer>
    </main>
  </div>

  <dialog class="app-dialog account-dialog" id="account-dialog" aria-labelledby="account-heading">
    <form id="account-form" class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">YOUR TRACKCAKE ACCOUNT</p><h2 id="account-heading">Keep your diary with you</h2></div>
        <button class="dialog-close" type="button" data-close="account-dialog" aria-label="Close dialog">×</button>
      </div>
      <p class="dialog-subtitle account-status is-info" id="account-status" role="status" aria-live="polite">Your food diary, wherever you go. Create a free account to sync your meals across devices.</p>
      <div class="account-profile-summary" id="account-profile-summary" hidden>
        <span class="account-profile-label">SIGNED-IN PROFILE</span>
        <strong id="account-profile-name"></strong>
        <span id="account-profile-email"></span>
      </div>
      <button class="secondary-button" id="account-resend" type="button" hidden>Resend verification email</button>
      <div id="account-fields">
        <label class="field full-field">Email address<input id="account-email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" /></label>
        <label class="field full-field" id="account-password-label">Password<input id="account-password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required placeholder="At least 8 characters" /></label>
        <label class="field full-field" id="account-password-confirm-label" hidden>Confirm new password<input id="account-password-confirm" type="password" autocomplete="new-password" minlength="8" maxlength="72" placeholder="Enter the new password again" /></label>
        <button class="account-forgot-link" id="account-forgot" type="button" hidden>Forgot password?</button>
        <div class="dialog-actions">
          <button class="secondary-button" id="account-mode-toggle" type="button">Already have an account? Sign in</button>
          <button class="primary-button" id="account-submit" type="submit">Create account</button>
        </div>
      </div>
      <div class="dialog-actions account-session-actions" id="account-session-actions" hidden>
        <button class="secondary-button" id="account-change-password" type="button">Forgot your password? Set a new one</button>
        <button class="secondary-button" id="account-signout" type="button">Sign out</button>
      </div>
    </form>
  </dialog>

  <dialog class="app-dialog food-action-dialog" id="food-action-dialog" aria-labelledby="food-action-heading">
    <div class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">FOOD ENTRY</p><h2 id="food-action-heading">Food options</h2><p class="dialog-subtitle" id="food-action-name"></p></div>
        <button class="dialog-close" type="button" data-close="food-action-dialog" aria-label="Close dialog">×</button>
      </div>
      <div class="food-action-options">
        <button class="secondary-button" type="button" data-food-action="edit">Edit food</button>
        <button class="secondary-button food-action-delete" type="button" data-food-action="delete">Delete food</button>
      </div>
    </div>
  </dialog>

  <dialog class="app-dialog" id="entry-dialog" aria-labelledby="entry-heading">
    <form id="entry-form" class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">FOOD DIARY</p><h2 id="entry-heading">Add a food</h2></div>
        <button class="dialog-close" type="button" data-close="entry-dialog" aria-label="Close dialog">×</button>
      </div>
      <div class="form-grid">
        <label class="field full-field">Food name<input id="entry-name" maxlength="90" required placeholder="e.g. Vegetable upma" /></label>
        <label class="field full-field">Amount / portion<input id="entry-amount" maxlength="90" required placeholder="e.g. 1 medium bowl (200 g)" /></label>
        <label class="field">Calories (kcal)<input id="entry-calories" type="number" min="0" max="10000" step="1" required /></label>
        <label class="field">Meal
          <select id="entry-meal">
            <option value="auto">Auto · based on time</option>
            <option value="breakfast">Breakfast</option><option value="lunch">Lunch</option><option value="dinner">Dinner</option><option value="snack">Snack</option>
          </select>
        </label>
        <label class="field">Protein (g)<input id="entry-protein" type="number" min="0" max="1000" step="0.1" value="0" /></label>
        <label class="field">Carbs (g)<input id="entry-carbs" type="number" min="0" max="1000" step="0.1" value="0" /></label>
        <label class="field">Fat (g)<input id="entry-fat" type="number" min="0" max="1000" step="0.1" value="0" /></label>
        <label class="field full-field">Eaten at<input id="entry-time" type="datetime-local" required /></label>
      </div>
      <div class="dialog-actions">
        <button class="secondary-button" type="button" data-close="entry-dialog">Cancel</button>
        <button class="primary-button" type="submit" id="entry-save">Save food</button>
      </div>
    </form>
  </dialog>

  <dialog class="app-dialog web-research-dialog" id="web-research-dialog" aria-labelledby="web-research-heading">
    <div class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">LIVE WEB RESEARCH · FIRECRAWL</p><h2 id="web-research-heading">Review scraped food information</h2><p class="dialog-subtitle">Raw page excerpts from live sources. Check the food and serving details before using extracted values or AI fallback.</p></div>
        <button class="dialog-close" type="button" data-close="web-research-dialog" aria-label="Close dialog">×</button>
      </div>
      <p class="web-research-status" id="web-research-status" aria-live="polite"></p>
      <div class="web-research-sources" id="web-research-sources"></div>
      <div class="dialog-actions">
        <button class="secondary-button" type="button" data-close="web-research-dialog">Cancel</button>
        <button class="primary-button" type="button" id="web-research-structure">Use nutrition data</button>
      </div>
    </div>
  </dialog>

  <dialog class="app-dialog recipe-dialog" id="recipe-builder-dialog" aria-labelledby="recipe-builder-heading">
    <form id="recipe-builder-form" class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">NUTRITION ENGINE V2</p><h2 id="recipe-builder-heading">Build a recipe</h2><p class="dialog-subtitle">Estimate measured ingredients separately, combine their nutrition and divide by servings.</p></div>
        <button class="dialog-close" type="button" data-close="recipe-builder-dialog" aria-label="Close dialog">×</button>
      </div>
      <label class="field">Recipe name<input id="recipe-name" maxlength="90" value="Homemade recipe" required /></label>
      <label class="field">Number of servings<input id="recipe-servings" type="number" min="1" max="50" step="1" value="1" required /></label>
      <label class="field">Ingredients <span class="field-help">One per line, with an explicit amount in grams or millilitres. Example: 100 g cooked rice.</span>
        <textarea id="recipe-ingredients" rows="6" maxlength="1600" placeholder="100 g cooked rice&#10;80 g cooked lentils&#10;5 ml olive oil" required></textarea>
      </label>
      <p class="recipe-status" id="recipe-status" aria-live="polite">Enter 2–8 ingredients. Household units are not guessed.</p>
      <div class="recipe-breakdown" id="recipe-breakdown" hidden></div>
      <section class="recipe-history" aria-labelledby="recipe-history-heading">
        <h3 id="recipe-history-heading">Saved recipes</h3>
        <div id="recipe-history-list" aria-live="polite">Your saved recipes will appear here.</div>
      </section>
      <div class="dialog-actions recipe-actions">
        <button class="secondary-button" type="button" data-close="recipe-builder-dialog">Cancel</button>
        <button class="secondary-button" type="submit" id="recipe-calculate">Calculate recipe</button>
        <button class="primary-button" type="button" id="recipe-review" disabled>Review recipe</button>
      </div>
    </form>
  </dialog>

  <dialog class="app-dialog review-dialog" id="review-dialog" aria-labelledby="review-heading">
    <form id="review-form" class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">AI ESTIMATE</p><h2 id="review-heading">Review your food</h2><p class="dialog-subtitle">Check the portions and calories before saving.</p>
          <p class="dialog-subtitle" id="estimate-attribution" aria-live="polite"></p></div>
        <button class="dialog-close" type="button" data-close="review-dialog" aria-label="Close dialog">×</button>
      </div>
      <div id="review-items" class="review-items"></div>
      <div class="review-save-options">
        <label class="field">Meal
          <select id="review-meal">
            <option value="auto">Auto · based on time</option>
            <option value="breakfast">Breakfast</option>
            <option value="lunch">Lunch</option>
            <option value="dinner">Dinner</option>
            <option value="snack">Snack</option>
          </select>
        </label>
        <label class="field">Eaten at
          <input id="review-time" type="datetime-local" required />
        </label>
        <p class="review-save-note">Each food is saved as its own diary entry. Auto chooses a meal from this time; you can change the tag whenever you like.</p>
      </div>
      <button class="review-add" id="review-add-item" type="button">＋ Add another item</button>
      <div class="review-total"><span>Total estimate</span><strong id="review-total">0 kcal</strong></div>
      <div class="dialog-actions">
        <button class="secondary-button" type="button" data-close="review-dialog">Cancel</button>
        <button class="primary-button" type="submit">Save to diary</button>
      </div>
    </form>
  </dialog>

  <dialog class="app-dialog goal-dialog" id="goal-dialog" aria-labelledby="goal-heading">
    <form id="goal-form" class="dialog-form">
      <div class="dialog-heading">
        <div><p class="card-kicker">YOUR DAILY TARGET</p><h2 id="goal-heading">Set your calorie goal</h2></div>
        <button class="dialog-close" type="button" data-close="goal-dialog" aria-label="Close dialog">×</button>
      </div>
      <p class="dialog-subtitle">Choose a daily target that makes sense for you. You can change it anytime.</p>
      <label class="field">Daily calories (kcal)<input id="goal-input" type="number" min="500" max="10000" step="50" required /></label>
      <p class="field-help">This is a personal tracking target, not a medical recommendation.</p>
      <div class="dialog-actions">
        <button class="secondary-button" type="button" data-close="goal-dialog">Cancel</button>
        <button class="primary-button" type="submit">Save goal</button>
      </div>
    </form>
  </dialog>

  
  <button class="calkie-launcher" id="calkie-launcher" type="button" aria-label="Chat with Calkie">
    <span class="calkie-launcher-face" aria-hidden="true">
      <img src="/images/calkie-bunny.svg?v=3" alt="" width="48" height="48" loading="eager" />
    </span><span class="calkie-launcher-label">Ask Calkie</span>
  </button>
  <section class="calkie-panel" id="calkie-panel" aria-label="Calkie personal food assistant" hidden>
    <header class="calkie-header">
      <div class="calkie-avatar" aria-hidden="true"><img src="/images/calkie-bunny.svg?v=3" alt="" width="48" height="48" loading="eager" /></div>
      <div class="calkie-heading"><strong>Calkie</strong><span>Your personal food buddy · private to you</span></div>
      <button id="calkie-close" class="calkie-close" type="button" aria-label="Close Calkie">×</button>
    </header>
    <div class="calkie-model-row">
      <label>AI brain<select id="calkie-provider"><option value="auto">Automatic · best available</option><option value="groq">Groq</option><option value="gemini">Gemini</option><option value="openrouter">OpenRouter</option></select></label>
      <label>Model<select id="calkie-model" disabled><option value="">Automatic fallback</option></select></label>
    </div>
    <div class="calkie-messages" id="calkie-messages" role="log" aria-live="polite">
      <div class="calkie-welcome"><span class="calkie-wave">✳</span><strong>Hey! I'm Calkie.</strong><p>I know your food diary. Ask me about meals, calories, macros or your eating patterns.</p></div>
    </div>
    <div class="calkie-suggestions" id="calkie-suggestions">
      <button type="button" data-prompt="How am I doing against my daily calorie goal?">My calorie goal</button>
      <button type="button" data-prompt="What did I eat yesterday?">Yesterday's food</button>
      <button type="button" data-prompt="How many calories did I eat last week?">Last week's calories</button>
      <button type="button" data-prompt="Which day did I eat the most calories?">My highest day</button>
    </div>
    <form class="calkie-compose" id="calkie-form">
      <label class="sr-only" for="calkie-input">Ask Calkie about your food diary</label>
      <textarea id="calkie-input" rows="1" maxlength="1500" placeholder="Ask anything about your food…" required></textarea>
      <button id="calkie-send" type="submit" aria-label="Send message"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 16 8-16 8 3-8-3-8Zm3 8h13" /></svg></button>
    </form>
    <p class="calkie-privacy">Calkie only sees the food diary linked to your signed-in account.</p>
  </section>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    import "../scripts/app";
    import "../scripts/ai-account";
    import "../scripts/calkie";
  </script>



</Layout>

